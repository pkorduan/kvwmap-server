#!/bin/bash

install_service() {
  echo "Installation von Service pgsql in Netzwerk '${NETWORK_NAME}'"
  SERVICE_NAME=pgsql

  SERVICE_PATH=${USER_DIR}/networks/${NETWORK_NAME}/services/${SERVICE_NAME}
  if [ -d "$SERVICE_PATH" ]; then
    echo "Der Service existiert in dem Netzwerk bereits. Abbruch."
    return 1
  fi

  if [ -z "$POSTGRES_PASSWORD" ]; then
    echo "Fehler: POSTGRES_PASSWORD ist nicht gesetzt. Abbruch."
    return 1
  fi
  echo "POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:0:5}..."

  if [ -z "$POSTGRES_KVWMAP_PASSWORD" ]; then
    echo "Fehler: POSTGRES_KVWMAP_PASSWORD ist nicht gesetzt. Abbruch."
    return 1
  fi
  echo "POSTGRES_KVWMAP_PASSWORD: ${POSTGRES_KVWMAP_PASSWORD:0:5}..."

  echo "Clone docker-postgis Repo nach ${SERVICE_PATH} ..."
  git clone --branch postgres-16-3.5 https://github.com/pkorduan/docker-postgis.git "${SERVICE_PATH}" || return 1

  echo "Erzeuge Verzeichnisse und setze Rechte ..."
  (cd "${SERVICE_PATH}" && ./post-clone.sh)

  cat > "${SERVICE_PATH}/.env" <<EOF
NETWORK_NAME="${NETWORK_NAME}"
SERVICE_NAME="${SERVICE_NAME}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD}"
POSTGRES_KVWMAP_PASSWORD="${POSTGRES_KVWMAP_PASSWORD}"
EOF
  chown 999:999 "${SERVICE_PATH}/.env"
  chmod 600 "${SERVICE_PATH}/.env"

  export SERVICE_NAME
  echo "Installation von pgsql in ${NETWORK_NAME} abgeschlossen."
}
